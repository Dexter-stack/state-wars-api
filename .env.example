# Same variable names as the Node API's .env.example, plus Laravel's APP_KEY / APP_ENV.
APP_NAME=StateWars
APP_ENV=local
APP_KEY=
APP_DEBUG=false
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_CHANNEL=stderr

DATABASE_URL=postgres://postgres:postgres@localhost:5432/statewars
# PHP has no connection pool: each Octane worker holds one connection. Octane's worker count is capped at this.
PG_POOL_MAX=20
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# game rules
QUESTION_TIME_LIMIT_SEC=60
ANSWER_GRACE_MS=2500
PAUSE_BUDGET_MS=30000
BATTLE_HOUR_WAT=20
BATTLE_WINDOW_MIN=15
MIN_PLAYERS_RANKED=200
UPRISING_MULTIPLIER=2
LAUNCH_DATE_WAT=2026-10-01

# development only: play any time, reveal answers straight away. Must be false in production (refused at boot).
DEV_ALWAYS_OPEN=true

# rate limits
RATE_GLOBAL_PER_MIN=240
RATE_AUTH_PER_HOUR=20
