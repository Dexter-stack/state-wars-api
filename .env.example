# Same variable names as the Node API's .env.example, plus Laravel's APP_KEY / APP_ENV.
APP_NAME=StateWars
APP_ENV=local
APP_KEY=
APP_DEBUG=false
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_CHANNEL=stderr

DATABASE_URL=postgres://postgres:postgres@localhost:5432/statewars
# PHP has no connection pool: each Octane worker holds one connection. Octane's worker count is capped at this.
PG_POOL_MAX=20
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# game rules
QUESTION_TIME_LIMIT_SEC=60
ANSWER_GRACE_MS=2500
PAUSE_BUDGET_MS=30000
BATTLE_HOUR_WAT=20
BATTLE_WINDOW_MIN=15
MIN_PLAYERS_RANKED=200
UPRISING_MULTIPLIER=2
LAUNCH_DATE_WAT=2026-10-01

# development only: play any time, reveal answers straight away. Must be false in production (refused at boot).
DEV_ALWAYS_OPEN=true

# Accounts need an email and a password. true re-opens the old guest sign-up (no email, no password):
# only for running the Node smoke/burst scripts. Leave false everywhere else.
GUEST_SIGNUP=false

# email (sign-in codes). "log" writes each email to storage/logs/mail.log instead of sending it: development only.
# Production: MAIL_MAILER=smtp plus MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD and a real MAIL_FROM_ADDRESS.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=StateWars

# rate limits
RATE_GLOBAL_PER_MIN=240
RATE_AUTH_PER_HOUR=20
