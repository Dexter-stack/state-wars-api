<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Feature tests use real PostgreSQL and Redis: same server and credentials as .env, separate database. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="NODE_ENV" value="test" force="true"/>
        <env name="DB_TEST_DATABASE" value="statewars_test" force="true"/>
        <env name="REDIS_DB" value="15" force="true"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="DEV_ALWAYS_OPEN" value="(false)" force="true"/>
        <env name="MIN_PLAYERS_RANKED" value="1" force="true"/>
        <env name="RATE_GLOBAL_PER_MIN" value="100000" force="true"/>
        <env name="RATE_AUTH_PER_HOUR" value="100000" force="true"/>
    </php>
</phpunit>
